# Copie para .env e preencha. O .env nunca deve ir para repositório.
# Mesmos nomes do winthor-mcp (VanguardIA), então o mesmo .env serve aos dois.
WINTHOR_DB_HOST=oracle.exemplo.local
WINTHOR_DB_PORT=1521
WINTHOR_DB_SERVICE=WINT
# Usuário Oracle só com SELECT (de preferência apontando para a réplica)
WINTHOR_DB_USER=consulta_mcp
WINTHOR_DB_PASSWORD=troque-esta-senha
# Dono das tabelas do ERP (ex.: WINTHOR). Vazio = o próprio usuário.
WINTHOR_DB_SCHEMA=
# Alternativa a HOST/PORT/SERVICE: string completa (Easy Connect)
# WINTHOR_DB_DSN=oracle.exemplo.local:1521/WINT
